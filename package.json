{
  "name": "@openoracle/sdk",
  "version": "0.1.0",
  "description": "Open Oracle SDK — real equity prices (Pyth), market hours, Uniswap pool prices, tokenized-stock premium and StockGuardHook fee quotes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "viem": "^2.57.4",
    "vitest": "^5.0.3"
  }
}
